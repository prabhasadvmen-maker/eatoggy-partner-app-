					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"mobile\": \"8601140605\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/delivery-auth/send-otp",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"delivery-auth",
								"send-otp"
							]
						},
						"description": "Send 6-digit OTP to Delivery Partner mobile number.\nAuth: Public\nBody: mobile"
					},
					"response": []
				},
				{
					"name": "2. Delivery Partner Verify OTP",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 or 201\", function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
									"});",
									"",
									"try {",
									"    var jsonData = pm.response.json();",
									"    var token = jsonData.token || (jsonData.data && jsonData.data.token) || jsonData.jwt || (jsonData.data && jsonData.data.jwt);",
									"    if (token) {",
									"        pm.collectionVariables.set(\"deliveryPartnerToken\", token);",
									"        console.log(\"Saved deliveryPartnerToken to collection variables:\", token);",
									"    }",
									"} catch (e) {",
									"    console.error(\"Error parsing response token:\", e);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"mobile\": \"8601140605\",\n  \"otp\": \"217647\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/delivery-auth/verify-otp",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"delivery-auth",
								"verify-otp"
							]
						},
						"description": "Verify OTP for Delivery Partner. Auto-creates account if new mobile or authenticates existing partner. Returns Delivery Partner JWT and currentStep.\nAuth: Public\nBody: mobile, otp\n\n*Note: Automatically stores the returned token into {{deliveryPartnerToken}} collection variable!*"
					},
					"response": []
				},
